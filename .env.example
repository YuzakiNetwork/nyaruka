# ════════════════════════════════════════
#  Bot Configuration
# ════════════════════════════════════════

BOT_NAME=Haruka Fuyune
BOT_PREFIX=!

# Nomor WA bot (format internasional, tanpa + atau spasi)
BOT_NUMBER=

# ════════════════════════════════════════
#  Owner ID — BACA INI DULU
# ════════════════════════════════════════
#
# WhatsApp sekarang pakai DUA format ID user secara bersamaan:
#
#  ┌─────────────────────────────────────────────────────────────┐
#  │ @s.whatsapp.net  = Nomor WA lama (628xxx@s.whatsapp.net)   │
#  │ @lid             = Linked Device ID (xxxxxxxx@lid)          │
#  │                                                             │
#  │ Baileys 6.7+ mulai full migrasi ke @lid.                   │
#  │ Bot perlu keduanya karena:                                  │
#  │  - Pesan lama / beberapa device → @s.whatsapp.net          │
#  │  - Pesan baru (mayoritas)       → @lid                     │
#  └─────────────────────────────────────────────────────────────┘
#
#  CARA DAPAT LID KAMU:
#  1. Jalankan bot
#  2. Kirim command apapun dari HP kamu (misal !ping)
#  3. Lihat terminal — akan muncul:
#     [12:34:56] ✓ 169969455263976@lid [DM] [info] !ping
#  4. Angka sebelum @lid itu = LID kamu
#  5. Isi di BOT_OWNER_LID tanpa @lid
#
#  ATAU: ketik !mylid di chat dengan bot
#
#  Multiple owner: pisah dengan koma
#  BOT_OWNER_NUMBER=628111,628222
#  BOT_OWNER_LID=169969111,169969222
#

# Nomor WA owner (format 628xxx, tanpa + atau spasi)
BOT_OWNER_NUMBER=

# LID owner (angka saja, tanpa @lid)
BOT_OWNER_LID=

# Legacy (opsional, backward compat)
# BOT_OWNER=<your-owner-number>  # optional legacy setting

# ════════════════════════════════════════
#  Session
# ════════════════════════════════════════

SESSION_NAME=session

# ════════════════════════════════════════
#  Database
# ════════════════════════════════════════

DB_PATH=./database
ECONOMY_TICK_INTERVAL=5

# ════════════════════════════════════════
#  Feature Flags
# ════════════════════════════════════════

ENABLE_WORLD_EVENTS=true
ENABLE_ECONOMY_SIMULATION=true
ENABLE_DUNGEON_SYSTEM=true

# ════════════════════════════════════════
#  Cooldowns (detik)
# ════════════════════════════════════════

BATTLE_COOLDOWN=30
DUNGEON_COOLDOWN=300
SHOP_COOLDOWN=5

# ════════════════════════════════════════
#  Economy Tuning
# ════════════════════════════════════════

PRICE_VOLATILITY_BASE=0.05
PRICE_MEAN_REVERSION_RATE=0.02
DEMAND_DECAY_RATE=0.1

# ════════════════════════════════════════
#  Trakteer Setup
# ════════════════════════════════════════


TRAKTEER_ENABLED=false

# API Key dari dashboard Trakteer
# Contoh: <your-trakteer-api-key>
TRAKTEER_API_KEY=

# Interval polling dalam milidetik (default 30000 = 30 detik)
# Jangan terlalu cepat agar tidak kena rate limit
TRAKTEER_POLL_INTERVAL=30000

# Target notifikasi WA (Group ID atau DM, pisah koma jika >1)
# Cara dapat: kirim !donate settarget di grup, bot akan kasih ID
# Contoh: <group-jid>,<phone-jid>
DONATE_NOTIFY_TARGETS=



# ════════════════════════════════════════
#  Logging
# ════════════════════════════════════════

LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════
#  Multi-prefix (comma-separated)
# ═══════════════════════════════════════════════════════════════════════════
BOT_PREFIXES=!,.,/,#,>,+

# JSON Database path
# DB_PATH=./data
